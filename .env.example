# Sipariş WhatsApp numarası — ülke kodu ile, sadece rakam.
# Boş bırakılırsa koddaki işletme numarası (905369948517) kullanılır.
VITE_WHATSAPP_NUMBER=905369948517

# Google Maps embed / link için (opsiyonel)
VITE_GOOGLE_MAPS_API_KEY=

# İleride gerçek backend'e bağlanınca kullanılacak
VITE_API_URL=

# Google Analytics 4 ölçüm kimliği (G-...). Asıl değer src/lib/analytics.ts içindeki
# OLCUM_KIMLIGI sabitinde; burası yalnızca yerel denemede geçersiz kılmak için.
VITE_GA_ID=

# Admin paneli yalnızca geliştirme sunucusunda açılır ve üretim paketine hiç
# girmez. Şifre burada tanımlı değilse panele giriş yapılamaz.
VITE_ADMIN_PASSWORD=
